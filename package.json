{
  "name": "space-club-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/build_vendor.mjs",
    "check:security": "node scripts/check_security_ui.mjs && node scripts/check_security_database.mjs",
    "check:admin-mail": "node scripts/check_admin_email_database.mjs && node scripts/check_admin_email_ui.mjs && node scripts/check_admin_email_worker.mjs",
    "check:chapter-operations": "node scripts/check_chapter_operations_database.mjs && node scripts/check_chapter_operations_ui.mjs",
    "check:chapters": "node scripts/check_chapters_database.mjs && node scripts/check_chapters_ui.mjs",
    "check:migrations": "node scripts/database_migrations.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "esbuild": "0.28.2"
  }
}
